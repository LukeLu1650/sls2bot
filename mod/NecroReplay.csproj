<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>NecroReplay</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">$(ProgramFiles(x86))/Steam/steamapps/common/Slay the Spire 2</GameDir>
    <GameData>$(GameDir)/data_sts2_windows_x86_64</GameData>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2" HintPath="$(GameData)/sts2.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(GameData)/GodotSharp.dll" Private="false" />
  </ItemGroup>
</Project>
