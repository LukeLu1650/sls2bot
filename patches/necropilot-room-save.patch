 // 管道模式：标准输出只用于协议帧，其余输出都写标准错误。必须在碰到游戏程序集之前设置：
 // v0.111.0 起 sts2.dll 的模块初始化器（Sentry）会往 Console.Out 打一行字，晚了就会混进协议帧，Python 端读到乱的帧长后一直等
 if (args.FirstOrDefault(a => !a.StartsWith('-')) == "serve") Console.SetOut(Console.Error);
+// Steam's Godot process can pass its Sentry native library to child processes. The
+// game assembly's module initializer would call that library before our shims run.
+// A standalone headless process has no Godot extension to initialize.
+Environment.SetEnvironmentVariable("SENTRY_GODOT_LIB_PATH", null);
 GameAssemblies.Register();
 Cli.Run(args);
 
