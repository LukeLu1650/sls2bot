@@ -0,0 +1,345 @@
+"""Three-tier native Windows throughput benchmark for AlphaDefect on v0.113.1.
+
+Tiers (all using persistent Sts2Headless.dll + binary obs frames):
+  1. collect : Pure headless collection (async VecEnv, random legal actions, snapshots on)
+  2. infer   : Async VecEnv + batched PolicyValueNet inference on GPU/CPU
+  3. ppo     : End-to-end multi-actor PPO training (runs sts2rl.train for a short step budget)
+
+Example (run after S6 completes):
+  $env:PYTHONPATH = (Resolve-Path 'artifacts/ppo-cuda').Path
+  & $py -u external/AlphaDefect-Public/tools/win_bench.py --tier collect --envs 16 --seconds 20
+  & $py -u external/AlphaDefect-Public/tools/win_bench.py --tier infer   --envs 16 --seconds 20 --device cuda
+  & $py -u external/AlphaDefect-Public/tools/win_bench.py --tier ppo     --actors 2 --envs-per-actor 12 --total-steps 65536
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPO / "python"))
+
+import numpy as np  # noqa: E402
+import torch  # noqa: E402
+from sts2env.env import DEFAULT_DLL, DOTNET, EngineError, VecEnv  # noqa: E402
+from sts2env.protocol import format_for  # noqa: E402
+from sts2rl.features import Ragged, collate_ragged  # noqa: E402
+from sts2rl.model import ModelConfig, PolicyValueNet  # noqa: E402
+
+
+def _make_reset(character: str, asc: int, seed: str, obs_format: int, snapshots: bool) -> dict:
+    return {
+        "op": "reset",
+        "mode": "run",
+        "character": character,
+        "ascension": asc,
+        "seed": seed,
+        "snapshots": snapshots,
+        "obs_format": obs_format,
+        "loop_cut": True,
+        "stall_turns": 20,
+    }
+
+
+def bench_collect(args: argparse.Namespace) -> dict:
+    fmt = args.obs_format or format_for(args.character)
+    rng = np.random.default_rng(12345)
+    seed_seq = 0
+    decisions = 0
+    runs_done = 0
+    snaps = 0
+    errors = 0
+
+    with VecEnv(args.envs, dll=args.dll) as vec:
+        for i in range(args.envs):
+            seed_seq += 1
+            vec.send(i, _make_reset(args.character, args.asc, f"WB{seed_seq}", fmt, True))
+        # Warmup: wait for initial resets so JIT/startup is separated from steady-state rate
+        warmed = 0
+        while warmed < args.envs:
+            for i, obs in vec.recv_ready(timeout=60.0):
+                if isinstance(obs, Exception):
+                    errors += 1
+                    seed_seq += 1
+                    vec.send(i, _make_reset(args.character, args.asc, f"WB{seed_seq}", fmt, True))
+                else:
+                    warmed += 1
+                    vec.send_step(i, int(rng.integers(0, max(1, obs.num_actions))))
+
+        t0 = time.perf_counter()
+        deadline = t0 + args.seconds
+        t_wait = 0.0
+        batches = 0
+        while time.perf_counter() < deadline:
+            tw = time.perf_counter()
+            ready = vec.recv_ready(timeout=10.0)
+            t_wait += time.perf_counter() - tw
+            if not ready:
+                continue
+            batches += 1
+            for i, obs in ready:
+                if isinstance(obs, Exception):
+                    errors += 1
+                    seed_seq += 1
+                    vec.send(i, _make_reset(args.character, args.asc, f"WB{seed_seq}", fmt, True))
+                    continue
+                if obs.extra and obs.extra.get("snapshot"):
+                    snaps += 1
+                if obs.done or obs.num_actions <= 0:
+                    runs_done += 1
+                    seed_seq += 1
+                    vec.send(i, _make_reset(args.character, args.asc, f"WB{seed_seq}", fmt, True))
+                else:
+                    decisions += 1
+                    vec.send_step(i, int(rng.integers(0, obs.num_actions)))
+        dt = time.perf_counter() - t0
+
+    return {
+        "tier": "collect",
+        "character": args.character,
+        "ascension": args.asc,
+        "obs_format": fmt,
+        "envs": args.envs,
+        "seconds": round(dt, 2),
+        "decisions": decisions,
+        "decisions_per_sec": round(decisions / max(dt, 1e-6), 1),
+        "runs_completed": runs_done,
+        "snapshots_captured": snaps,
+        "avg_ready_batch": round(decisions / max(1, batches), 2),
+        "wait_share": round(t_wait / max(dt, 1e-6), 3),
+        "errors": errors,
+    }
+
+
+def _necro_model_cfg() -> ModelConfig:
+    base_path = REPO / "tools" / "remote" / "necro" / "train_config.json"
+    if base_path.exists():
+        raw = json.loads(base_path.read_text(encoding="utf-8"))
+        return ModelConfig(**raw["model"])
+    return ModelConfig(d=256, layers=6, heads=4, ff_mult=4)
+
+
+def bench_infer(args: argparse.Namespace) -> dict:
+    fmt = args.obs_format or format_for(args.character)
+    device = torch.device(args.device)
+    cfg = _necro_model_cfg()
+    net = PolicyValueNet(cfg).to(device).eval()
+    net.infer_ready()
+    use_bf16 = device.type == "cuda" and not args.fp32
+    rng = np.random.default_rng(12345)
+
+    seed_seq = 0
+    decisions = 0
+    runs_done = 0
+    errors = 0
+    t_wait = 0.0
+    t_collate = 0.0
+    t_fwd = 0.0
+    fwd_batches = 0
+    fwd_rows = 0
+
+    with VecEnv(args.envs, dll=args.dll) as vec:
+        for i in range(args.envs):
+            seed_seq += 1
+            vec.send(i, _make_reset(args.character, args.asc, f"WI{seed_seq}", fmt, True))
+        # Warmup resets + 1 forward pass
+        warm_obs = []
+        while len(warm_obs) < args.envs:
+            for i, obs in vec.recv_ready(timeout=60.0):
+                if isinstance(obs, Exception):
+                    errors += 1
+                    seed_seq += 1
+                    vec.send(i, _make_reset(args.character, args.asc, f"WI{seed_seq}", fmt, True))
+                else:
+                    warm_obs.append((i, obs))
+        with torch.inference_mode(), torch.autocast(device.type, dtype=torch.bfloat16, enabled=use_bf16):
+            b0 = collate_ragged(Ragged.from_obs([o for _, o in warm_obs])).to(device)
+            net.forward_infer(b0)
+        for i, obs in warm_obs:
+            vec.send_step(i, int(rng.integers(0, max(1, obs.num_actions))))
+
+        t0 = time.perf_counter()
+        deadline = t0 + args.seconds
+        min_batch = max(1, min(args.envs // 2, args.min_batch))
+        wait_s = args.wait_ms / 1000.0
+
+        while time.perf_counter() < deadline:
+            tw = time.perf_counter()
+            ready = vec.recv_ready(timeout=10.0)
+            batch_items = list(ready)
+            if batch_items and len(batch_items) < min_batch and wait_s > 0:
+                t_end = time.perf_counter() + wait_s
+                while len(batch_items) < min_batch and time.perf_counter() < t_end and vec.pending:
+                    rem = max(0.0, t_end - time.perf_counter())
+                    more = vec.recv_ready(timeout=rem)
+                    if not more:
+                        break
+                    batch_items.extend(more)
+            t_wait += time.perf_counter() - tw
+
+            live_idx = []
+            live_obs = []
+            for i, obs in batch_items:
+                if isinstance(obs, Exception):
+                    errors += 1
+                    seed_seq += 1
+                    vec.send(i, _make_reset(args.character, args.asc, f"WI{seed_seq}", fmt, True))
+                    continue
+                if obs.done or obs.num_actions <= 0:
+                    runs_done += 1
+                    seed_seq += 1
+                    vec.send(i, _make_reset(args.character, args.asc, f"WI{seed_seq}", fmt, True))
+                    continue
+                if obs.num_actions == 1:
+                    decisions += 1
+                    vec.send_step(i, 0)
+                    continue
+                live_idx.append(i)
+                live_obs.append(obs)
+
+            if not live_obs:
+                continue
+
+            tc = time.perf_counter()
+            b = collate_ragged(Ragged.from_obs(live_obs))
+            t_collate += time.perf_counter() - tc
+
+            tf = time.perf_counter()
+            with torch.inference_mode(), torch.autocast(device.type, dtype=torch.bfloat16, enabled=use_bf16):
+                logits, _ = net.forward_infer(b.to(device))
+                acts = logits.argmax(dim=-1).cpu().numpy()
+            t_fwd += time.perf_counter() - tf
+            fwd_batches += 1
+            fwd_rows += len(live_obs)
+
+            for i, a in zip(live_idx, acts):
+                decisions += 1
+                vec.send_step(i, int(a))
+
+        dt = time.perf_counter() - t0
+
+    return {
+        "tier": "infer",
+        "character": args.character,
+        "ascension": args.asc,
+        "obs_format": fmt,
+        "device": str(device),
+        "bf16": use_bf16,
+        "envs": args.envs,
+        "seconds": round(dt, 2),
+        "decisions": decisions,
+        "decisions_per_sec": round(decisions / max(dt, 1e-6), 1),
+        "runs_completed": runs_done,
+        "avg_infer_batch": round(fwd_rows / max(1, fwd_batches), 2),
+        "wait_share": round(t_wait / max(dt, 1e-6), 3),
+        "collate_share": round(t_collate / max(dt, 1e-6), 3),
+        "fwd_share": round(t_fwd / max(dt, 1e-6), 3),
+        "errors": errors,
+    }
+
+
+def bench_ppo(args: argparse.Namespace) -> dict:
+    run_dir = Path(args.run_dir) if args.run_dir else Path(tempfile.mkdtemp(prefix="ad_win_ppo_bench_"))
+    run_dir.mkdir(parents=True, exist_ok=True)
+    base_cfg_path = REPO / "tools" / "remote" / "necro" / "train_config.json"
+    cfg = json.loads(base_cfg_path.read_text(encoding="utf-8"))
+    cfg.update({
+        "run_dir": str(run_dir),
+        "character": args.character,
+        "actors": args.actors,
+        "envs_per_actor": args.envs_per_actor,
+        "actor_device": args.device,
+        "learner_device": args.device,
+        "learner_compile": False if os.name == "nt" else bool(cfg.get("learner_compile", False)),
+        "batch_steps": args.batch_steps,
+        "minibatch": args.minibatch,
+        "grad_accum": max(1, args.grad_accum),
+        "total_steps": args.total_steps,
+        "eval_every_s": 0.0,
+        "eval_runs": 0,
+        "eval_combats": 0,
+        "save_every": 999999,
+        "log_every": 1,
+    })
+    cfg_path = run_dir / "bench_config.json"
+    cfg_path.write_text(json.dumps(cfg, ensure_ascii=False, indent=2), encoding="utf-8")
+
+    env = dict(os.environ)
+    py_path = str(REPO / "python")
+    env["PYTHONPATH"] = py_path + (os.pathsep + env["PYTHONPATH"] if env.get("PYTHONPATH") else "")
+    cmd = [sys.executable, "-u", "-m", "sts2rl.train", "--config", str(cfg_path)]
+    t0 = time.perf_counter()
+    proc = subprocess.run(cmd, env=env)
+    dt = time.perf_counter() - t0
+    metrics_path = run_dir / "log.jsonl"
+    recs = []
+    if metrics_path.exists():
+        recs = [json.loads(ln) for ln in metrics_path.read_text(encoding="utf-8").splitlines() if ln.strip()]
+    last = recs[-1] if recs else None
+    steady_sps = None
+    if len(recs) >= 2:
+        t_span = recs[-1].get("time", 0.0) - recs[0].get("time", 0.0)
+        s_span = recs[-1].get("total_steps", 0) - recs[0].get("total_steps", 0)
+        if t_span > 0:
+            steady_sps = round(s_span / t_span, 1)
+    return {
+        "tier": "ppo",
+        "exit_code": proc.returncode,
+        "run_dir": str(run_dir),
+        "actors": args.actors,
+        "envs_per_actor": args.envs_per_actor,
+        "total_envs": args.actors * args.envs_per_actor,
+        "batch_steps": args.batch_steps,
+        "total_steps_target": args.total_steps,
+        "updates_completed": len(recs),
+        "wall_seconds": round(dt, 2),
+        "overall_decisions_per_sec": round((last.get("total_steps", 0) if last else 0) / max(dt, 1e-6), 1),
+        "steady_decisions_per_sec": steady_sps,
+        "last_t_collect": last.get("t_collect") if last else None,
+        "last_t_learn": last.get("t_learn") if last else None,
+        "last_t_prep": last.get("t_prep") if last else None,
+        "last_t_ppo": last.get("t_ppo") if last else None,
+    }
+
+
+def main() -> None:
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--tier", choices=("collect", "infer", "ppo"), required=True)
+    p.add_argument("--character", default="NECROBINDER")
+    p.add_argument("--asc", type=int, default=0)
+    p.add_argument("--obs-format", type=int, default=0)
+    p.add_argument("--dll", type=Path, default=DEFAULT_DLL)
+    p.add_argument("--envs", type=int, default=16)
+    p.add_argument("--seconds", type=float, default=20.0)
+    p.add_argument("--device", default="cuda" if torch.cuda.is_available() else "cpu")
+    p.add_argument("--fp32", action="store_true")
+    p.add_argument("--min-batch", type=int, default=8)
+    p.add_argument("--wait-ms", type=float, default=2.0)
+    # Tier 3 (PPO) options
+    p.add_argument("--actors", type=int, default=2)
+    p.add_argument("--envs-per-actor", type=int, default=12)
+    p.add_argument("--batch-steps", type=int, default=16384)
+    p.add_argument("--minibatch", type=int, default=1024)
+    p.add_argument("--grad-accum", type=int, default=1)
+    p.add_argument("--total-steps", type=int, default=65536)
+    p.add_argument("--run-dir", type=str, default="")
+    args = p.parse_args()
+
+    print(f"DOTNET={DOTNET} | DLL={args.dll}", flush=True)
+    if args.tier == "collect":
+        res = bench_collect(args)
+    elif args.tier == "infer":
+        res = bench_infer(args)
+    else:
+        res = bench_ppo(args)
+    print(json.dumps(res, ensure_ascii=False, indent=2), flush=True)
+
+
+if __name__ == "__main__":
+    main()
